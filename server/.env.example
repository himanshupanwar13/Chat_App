# ==========================================
# ChatterFlow Server Environment Variables
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client Application URL (comma-separated if multiple, e.g. https://chatterflow.tech,https://chatterflow.vercel.app)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.b8ckv.mongodb.net/?appName=Cluster0

# JWT Authentication Secret Key
JWT_SECRET_KEY=your_strong_jwt_secret_key_here

# Email Service Provider (brevo | mock | test)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=no-reply@chatterflow.tech
EMAIL_FROM_NAME=ChatterFlow

# Cloudinary Cloud Storage (Production Attachment & Avatar Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
